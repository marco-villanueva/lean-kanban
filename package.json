{
  "name": "lean-kanban",
  "version": "1.0.0",
  "private": true,
  "description": "Lean Kanban — React + Express + SQLite + MCP. Deliberately boring code.",
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:api": "pnpm --filter @lean-kanban/api dev",
    "dev:web": "pnpm --filter @lean-kanban/web dev",
    "dev:mcp": "pnpm --filter @lean-kanban/mcp dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "start:api": "pnpm --filter @lean-kanban/api start",
    "db:migrate": "pnpm --filter @lean-kanban/api db:migrate",
    "db:seed": "pnpm --filter @lean-kanban/api db:seed",
    "test": "pnpm -r --if-present run test",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
